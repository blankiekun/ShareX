#!/bin/sh
# Answers with what the test asked for: FAKE_FFPROBE_ERROR makes it fail, otherwise it prints FAKE_FFPROBE_JSON.
# FAKE_FFPROBE_DIE ends it the way a dying tool does: KILL is a real SIGKILL, a number is that exit code. No real SIGSEGV,
# because that would reach the desktop's crash handler.
case "$FAKE_FFPROBE_DIE" in
    "") ;;
    KILL) kill -KILL $$ ;;
    *) exit "$FAKE_FFPROBE_DIE" ;;
esac
if [ -n "$FAKE_FFPROBE_ERROR" ]; then
    printf '%s\n' "$FAKE_FFPROBE_ERROR" >&2
    exit 1
fi
printf '%s\n' "$FAKE_FFPROBE_JSON"
