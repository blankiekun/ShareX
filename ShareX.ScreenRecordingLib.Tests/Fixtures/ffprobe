#!/bin/sh
# Answers with what the test asked for: FAKE_FFPROBE_ERROR makes it fail, otherwise it prints FAKE_FFPROBE_JSON.
# The real one answers -version whatever a file looks like: a bad file doesn't mean a broken tool.
if [ "$1" = "-version" ]; then
    exit 0
fi
if [ -n "$FAKE_FFPROBE_ERROR" ]; then
    printf '%s\n' "$FAKE_FFPROBE_ERROR" >&2
    exit 1
fi
printf '%s\n' "$FAKE_FFPROBE_JSON"
